{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    " - %@": {
      "comment": "A row in the weekly suggestions view, displaying a main label and a detail label. The argument is the main label, and the second argument is the detail label.",
      "isCommentAutoGenerated": true
    },
    " %@": {
      "comment": "A phrase that appears in the timeline review summary card, indicating that the user can review their data and update it. The argument is the string “Review %arg”.",
      "isCommentAutoGenerated": true
    },
    " LLM, but we strongly recommend using Qwen3-VL 4B based on our internal benchmarks.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " LLM을 쓸 수 있지만, 내부 벤치마크 기준 Qwen3-VL 4B를 강력히 권장합니다."
          }
        }
      }
    },
    " to update your data.": {
      "comment": "A phrase appended to the end of a review count to indicate that it can be used to update the user's review data.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 데이터를 업데이트하세요."
          }
        }
      }
    },
    " when they use Dayflow for 40 hours!": {
      "comment": "A phrase explaining the bonus provided for referring others to Dayflow.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 친구가 Dayflow를 40시간 사용하면 받습니다!"
          }
        }
      }
    },
    " You can switch at any time in the settings.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 설정에서 언제든 변경할 수 있습니다."
          }
        }
      }
    },
    ":": {
      "comment": "A colon character used in time display.",
      "isCommentAutoGenerated": true
    },
    "!": {
      "comment": "An exclamation mark used to indicate that a card has been generated using a lower-quality model.",
      "isCommentAutoGenerated": true
    },
    ".": {
      "comment": "A period used in the text under the category pills.",
      "isCommentAutoGenerated": true
    },
    "“%@” will be removed from your onboarding categories.": {
      "comment": "A message displayed when a user attempts to delete a category. The argument is the name of the category that is about to be deleted.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”이(가) 온보딩 카테고리에서 제거됩니다."
          }
        }
      }
    },
    "(aistudio.google.com)": {},
    "%@ - %@": {
      "comment": "A label displaying the start and end times of an activity. The format used is \"HH:mm\" (24-hour time format).",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ - %2$@"
          }
        }
      }
    },
    "%@ pt": {
      "comment": "A text view displaying the current value of the slider, formatted to one decimal place.",
      "isCommentAutoGenerated": true
    },
    "%@ to %@": {
      "comment": "A time range displayed in a caption below the title of a screenshot slideshow modal. The time format used is \"HH:mm\".",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ to %2$@"
          }
        }
      }
    },
    "%lld": {
      "comment": "A label displaying the number of cards to review.",
      "isCommentAutoGenerated": true
    },
    "%lld %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld %2$@"
          }
        }
      }
    },
    "%lld hours": {
      "comment": "A label displaying the total time spent across all categories, formatted as hours and minutes.",
      "isCommentAutoGenerated": true
    },
    "%lld minutes": {
      "comment": "A sublabel inside the donut chart that shows the number of minutes spent in various activities. The argument is the number of minutes.",
      "isCommentAutoGenerated": true
    },
    "%lld.": {
      "comment": "A numbered list item within a dosage instructions view. The number is automatically generated based on the index of the bullet point in the list.",
      "isCommentAutoGenerated": true
    },
    "%lld/%lld": {
      "comment": "A text field displaying the current number of characters in the memory panel, followed by a slash and the maximum allowed number of characters.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld/%2$lld"
          }
        }
      }
    },
    "%lld%%": {
      "comment": "A text label displaying the current percentage of a task or goal that has been completed. The text is styled with a custom font.",
      "isCommentAutoGenerated": true
    },
    "%lldx": {
      "comment": "A chip displaying the current playback speed of a video. The text inside the chip is the playback speed as a multiplier of 20 (e.g. \"40x\").",
      "isCommentAutoGenerated": true
    },
    "+ Add category": {
      "comment": "A button label that says \"+ Add category\".",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "+ 카테고리 추가"
          }
        }
      }
    },
    "∞": {},
    "✓ Permission granted! Click Next to continue.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ 권한이 부여되었습니다! 다음을 눌러 계속하세요."
          }
        }
      }
    },
    "000000": {
      "comment": "A placeholder text for a 6-digit verification code field.",
      "isCommentAutoGenerated": true
    },
    "1": {
      "comment": "A button with the text \"1\" that can be used to set the count of cards to review to 1.",
      "isCommentAutoGenerated": true
    },
    "1 Hour": {
      "comment": "Pause duration option in menu bar",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1시간"
